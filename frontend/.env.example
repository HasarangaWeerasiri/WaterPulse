# Frontend Environment Configuration - Development
# This file should be named `.env.development` or `.env.local` for Vite

# API Base URL - Points to backend API (default: localhost:5000)
# In development, this typically points to your local backend
VITE_API_BASE_URL=http://localhost:5000/api

# Development-specific settings
VITE_APP_NAME=WaterPulse Dev
